# ============================================
# VIDEO CLIPPER - Environment Variables
# ============================================

# PORT server berjalan
PORT=3000

# Redis (untuk job queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Provider transkripsi: assemblyai | groq
TRANSCRIBE_PROVIDER=assemblyai

# AssemblyAI API - direkomendasikan untuk podcast panjang
# Daftar di: https://www.assemblyai.com
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_POLL_INTERVAL_MS=3000

# Groq API (opsional fallback)
# Daftar di: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optimasi untuk audio panjang / podcast
# Chunk target disarankan di bawah 25MB karena limit upload Groq
TRANSCRIBE_CHUNK_TARGET_MB=22
TRANSCRIBE_AUDIO_BITRATE=32k
TRANSCRIBE_AUDIO_SAMPLE_RATE=16000
TRANSCRIBE_LANGUAGE=auto
TRANSCRIBE_RATE_LIMIT_MAX_RETRIES=2
TRANSCRIBE_RATE_LIMIT_MAX_WAIT_SECONDS=900

# ============================================
# LLM Gateway & Model (Provider-Neutral)
# ============================================
# ClipAIv2 TIDAK mengunci provider AI tertentu. Model dipilih lewat env ini,
# jadi bisa diganti bebas: 9Router lokal, OpenRouter, atau endpoint
# OpenAI-compatible apa pun. Lihat README.md → "Mengganti Model AI".
#
#   DEFAULT_MODEL  -> id model (menang atas AI_MODEL)
#   AI_MODEL       -> id model cadangan bila DEFAULT_MODEL kosong
#   AI_BASE_URL    -> base URL OpenAI-compatible (harus diakhiri /v1)
#   AI_API_KEY     -> kredensial gateway
#   AI_FALLBACK_BASE_URL / AI_FALLBACK_MODEL -> gateway & model sekunder (opsional)
#
# Contoh gateway lokal 9Router (port 20128) — ganti nilainya sesuai model yang
# tersedia di gateway kamu:
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=dummy
DEFAULT_MODEL=your-provider/your-model-name
AI_MODEL=your-provider/your-model-name
# Bila tidak diisi, fallback model otomatis memakai model utama.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=

# Contoh alternatif — pakai OpenRouter langsung:
# AI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# AI_MODEL=your-provider/your-model-name
AI_ANALYSIS_MAX_SEGMENTS=400
AI_ANALYSIS_WINDOW_SECONDS=30
AI_ANALYSIS_MAX_RETRIES=2
AI_ANALYSIS_MAX_COMPLETION_TOKENS=2200
WORKER_CONCURRENCY=1
FACE_TRACKING_ENABLED=true
FACE_TRACKING_PYTHON=python
FACE_TRACKING_SAFE_MARGIN_RATIO=0.18
SPEAKER_TRACKING_ENABLED=true
SPEAKER_SWITCH_MIN_SECONDS=2.4
SPEAKER_POSITION_PADDING_RATIO=0.14

# Direktori penyimpanan file
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# URL publik server (untuk generate download link)
BASE_URL=http://localhost:3000
